generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum StartOfWeek {
  MONDAY
  SUNDAY
}

enum StartupPage {
  DASHBOARD
  CALENDAR
  TASKS
}

enum Locale {
  UK
  EN
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

enum AuthProvider {
  GOOGLE
}

enum SpaceType {
  PERSONAL
  SHARED
}

enum SpaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SubtaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String?
  role            UserRole @default(USER)
  isEmailVerified Boolean  @default(false)

  profile                 Profile?
  settings                UserSettings?
  authSessions            AuthSession[]
  externalAccounts        ExternalAccount[]
  emailVerificationTokens EmailVerificationToken[]
  ownedSpaces             Space[]                  @relation("SpaceOwner")
  spaceMemberships        SpaceMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Space {
  id      String    @id @default(cuid())
  name    String
  type    SpaceType
  ownerId String

  owner      User          @relation("SpaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members    SpaceMember[]
  taskSpaces TaskSpace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([type])
}

model SpaceMember {
  id       String    @id @default(cuid())
  spaceId  String
  userId   String
  role     SpaceRole
  joinedAt DateTime  @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([spaceId, userId])
  @@index([userId])
  @@index([spaceId, role])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(LOW)

  taskSpaces TaskSpace[]
  subtasks   Subtask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskSpace {
  id      String @id @default(cuid())
  taskId  String
  spaceId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([taskId, spaceId])
  @@index([spaceId])
}

model Subtask {
  id       String        @id @default(cuid())
  taskId   String
  title    String
  status   SubtaskStatus @default(TODO)
  position Int

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  displayName String
  avatarUrl   String?
  timeZone    String  @default("Europe/Kyiv")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSettings {
  id                   String      @id @default(cuid())
  userId               String      @unique
  startOfWeek          StartOfWeek @default(MONDAY)
  startupPage          StartupPage @default(DASHBOARD)
  locale               Locale      @default(UK)
  theme                Theme       @default(SYSTEM)
  notificationsEnabled Boolean     @default(true)
  quietHoursEnabled    Boolean     @default(false)
  quietHoursStart      String?
  quietHoursEnd        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model ExternalAccount {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
